# Normalizar fin de línea en archivos de texto: LF en el repositorio y en la copia de trabajo
* text=auto eol=lf

# Archivos de texto
*.md    text eol=lf
*.txt   text eol=lf
*.py    text eol=lf
*.json  text eol=lf
*.csv   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.svg   text eol=lf

# Scripts de Windows con CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Documentos e imágenes (sin diff ni conversión de fin de línea)
*.pdf   binary
*.docx  binary
*.xlsx  binary
*.pptx  binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.zip   binary
*.db    binary

# RoboDK: estaciones y modelos de robots y herramientas de la biblioteca
*.rdk   binary
*.robot binary
*.tool  binary

# Modelos 3D. Los STL propios son ASCII, pero se tratan como binarios:
# diff ilegible y sin conversión; 01_generar_modelos.py los escribe con LF.
*.stl   binary
*.step  binary
*.stp   binary
